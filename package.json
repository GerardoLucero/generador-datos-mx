{
  "name": "generador-datos-mx",
  "version": "1.0.5",
  "type": "module",
  "description": "Generador de datos de prueba mexicanos realistas para testing y desarrollo",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "microbundle --no-compress",
    "build:prod": "microbundle",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run lint && npm run build:prod"
  },
  "keywords": [
    "mexico",
    "mexican",
    "generador",
    "datos",
    "testing",
    "faker",
    "mock",
    "rfc",
    "curp",
    "nss",
    "clabe",
    "generator",
    "test-data",
    "datos-prueba",
    "fake-data"
  ],
  "author": {
    "name": "Gerardo Lucero",
    "email": "tu-email@ejemplo.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GerardoLucero/generador-datos-mx.git"
  },
  "bugs": {
    "url": "https://github.com/GerardoLucero/generador-datos-mx/issues"
  },
  "homepage": "https://github.com/GerardoLucero/generador-datos-mx#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^8.57.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "microbundle": "^0.15.1"
  },
  "dependencies": {
    "dayjs": "^1.11.13"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  }
}
